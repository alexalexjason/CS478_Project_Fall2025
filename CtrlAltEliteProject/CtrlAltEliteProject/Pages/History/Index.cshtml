@page
@model CtrlAltEliteProject.Pages.History.IndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@{
    ViewData["Title"] = "Query History";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Entries != null && Model.Entries.Count > 0)
{
    <div class="mb-3">
        <label for="sourceFilter" class="form-label">Filter by source:</label>
        <select id="sourceFilter" class="form-select" style="max-width:200px;">
            <option value="">All</option>
            <option value="pdf">PDF</option>
            <option value="audio">Audio</option>
            <option value="chat">Chat</option>
        </select>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date & Time</th>
                <th>Source</th>
                <th>Summary</th>
                <th>Output</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="historyTable">
            @foreach (var entry in Model.Entries)
            {
                <tr class="history-row" data-source="@entry.Source">
                    <td>@entry.TimestampUtc</td>
                    <td><span class="badge bg-secondary">@entry.Source</span></td>
                    <td>@entry.InputSummary</td>
                    <td>
                        @if (!string.IsNullOrEmpty(entry.OutputPath))
                        {
                            var fileName = System.IO.Path.GetFileName(entry.OutputPath);
                            <small>@fileName</small>
                        }
                        else
                        {
                            <small class="text-muted">(no output)</small>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Delete" style="display:inline;">
                            <input type="hidden" name="interactionId" value="@entry.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this entry?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="alert alert-info">No query history found. Start by uploading a PDF, recording audio, or chatting!</p>
}

<a class="btn btn-secondary mt-3" href="~/">Back to Home</a>

<script>
    document.getElementById('sourceFilter').addEventListener('change', (e) => {
        const filter = e.target.value;
        document.querySelectorAll('.history-row').forEach(row => {
            row.style.display = (filter === '' || row.getAttribute('data-source') === filter) ? '' : 'none';
        });
    });
</script>