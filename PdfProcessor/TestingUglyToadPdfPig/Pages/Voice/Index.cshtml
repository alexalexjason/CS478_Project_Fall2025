@page
@model TestingUglyToadPdfPig.Pages.Voice.IndexModel
@{
    ViewData["Title"] = "PDF + Voice";
}

<h2>@ViewData["Title"]</h2>

<form method="post" enctype="multipart/form-data" class="mb-4">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Upload PDF</label>
        <input asp-for="PdfFile" type="file" accept="application/pdf" class="form-control" />
        <span class="form-text">Optional — upload a PDF to extract text from pages.</span>
    </div>

    <div class="mb-3">
        <label class="form-label">Voice-to-text</label>
        <div class="mb-2">
            <button type="button" id="startBtn" class="btn btn-primary btn-sm">Start</button>
            <button type="button" id="stopBtn" class="btn btn-outline-primary btn-sm" disabled>Stop</button>
            <button type="button" id="saveBtn" class="btn btn-success btn-sm" disabled>Save Voice Only</button>
            <span id="interim" class="text-muted ms-2"></span>
        </div>
        <textarea asp-for="VoiceText" id="finalText" class="form-control" rows="8">@Model.VoiceText</textarea>
        <div class="form-text">Captured speech is appended to the text area. Click Process below to submit both PDF and voice text to the server.</div>
    </div>

    <div>
        <button type="submit" class="btn btn-success">Process (PDF + Voice)</button>
        <a class="btn btn-secondary" href="~/">Back to Home</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.VoiceText))
{
    <section class="mt-4">
        <h4>Captured voice text</h4>
        <pre>@Model.VoiceText</pre>
    </section>
}

@if (Model.ExtractedPages != null && Model.ExtractedPages.Count > 0)
{
    <section class="mt-4">
        <h4>Extracted PDF text (per page)</h4>
        @for (int i = 0; i < Model.ExtractedPages.Count; i++)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h6 class="card-title">Page @(i + 1)</h6>
                    <pre class="mb-0">@Model.ExtractedPages[i]</pre>
                </div>
            </div>
        }
    </section>
}

@section Scripts {
    <script src="~/js/voice.js"></script>
    <script>
        (function () {
            const startBtn = document.getElementById('startBtn');
            const stopBtn = document.getElementById('stopBtn');
            const saveBtn = document.getElementById('saveBtn');
            const interimSpan = document.getElementById('interim');
            const textArea = document.getElementById('finalText');

            function onInterim(text) {
                interimSpan.textContent = text || '';
            }

            function onFinal(text) {
                if (!text) return;
                const current = textArea.value || '';
                textArea.value = current + (current && !current.endsWith(' ') ? ' ' : '') + text + '\n';
                interimSpan.textContent = '';
                saveBtn.disabled = false;
            }

            startBtn.addEventListener('click', function () {
                if (!window.VoiceRecognition) {
                    alert('Voice recognition not supported in this browser. Use Chrome/Edge on desktop or localhost with HTTPS.');
                    return;
                }
                window.VoiceRecognition.start(onInterim, onFinal);
                startBtn.disabled = true;
                stopBtn.disabled = false;
            });

            stopBtn.addEventListener('click', function () {
                if (window.VoiceRecognition) window.VoiceRecognition.stop();
                startBtn.disabled = false;
                stopBtn.disabled = true;
                interimSpan.textContent = '';
            });

            saveBtn.addEventListener('click', async function () {
                const text = textArea.value;
                if (!text) return;

                // read antiforgery token from the page
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                const form = new FormData();
                form.append('__RequestVerificationToken', token);
                form.append('text', text);

                const res = await fetch('?handler=Save', { method: 'POST', body: form });
                if (res.ok) {
                    alert('Saved voice text on server');
                    saveBtn.disabled = true;
                } else {
                    alert('Save failed');
                }
            });
        })();
    </script>
}